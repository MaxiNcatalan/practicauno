@page
@model practicauno.Pages.InscripcionTallerModel
@{
    ViewData["Title"] = "Inscripción a Talleres";
}

<h1>Inscripción a Talleres Extracurriculares</h1>

@if (Model.Errores != null && Model.Errores.Count > 0)
{
    <div class="alert alert-danger">
        <ul class="mb-0">
            @foreach (var err in Model.Errores)
            {
                <li>@err</li>
            }
        </ul>
    </div>
}
else if (!string.IsNullOrEmpty(Model.MensajeExito))
{
    <div class="alert alert-success">
        @Model.MensajeExito
    </div>
}

<form method="post" asp-page-handler="Inscribir" novalidate>
    <div class="mb-3">
        <label asp-for="NombreCompleto" class="form-label">Nombre completo</label>
        <input asp-for="NombreCompleto" class="form-control" />
        <span asp-validation-for="NombreCompleto" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DNI" class="form-label">DNI</label>
        <input asp-for="DNI" type="number" class="form-control" min="1000000" max="99999999" step="1" />
        <span asp-validation-for="DNI" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" type="email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmarEmail" class="form-label">Confirmar email</label>
        <input asp-for="ConfirmarEmail" type="email" class="form-control" />
        <span asp-validation-for="ConfirmarEmail" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FechaNacimiento" class="form-label">Fecha de nacimiento</label>
        <input asp-for="FechaNacimiento" type="date" class="form-control" />
        <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TallerElegido" class="form-label">Taller</label>
        <select asp-for="TallerElegido" class="form-select">
            <option value="">-- Seleccione un taller --</option>
            @foreach (var t in Model.Talleres)
            {
                <option value="@t">@t</option>
            }
        </select>
        <span asp-validation-for="TallerElegido" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label d-block">Turno</label>
        <div class="form-check form-check-inline">
            <input asp-for="Turno" class="form-check-input" type="radio" value="Mañana" id="turnoManana" />
            <label class="form-check-label" for="turnoManana">Mañana</label>
        </div>
        <div class="form-check form-check-inline">
            <input asp-for="Turno" class="form-check-input" type="radio" value="Tarde" id="turnoTarde" />
            <label class="form-check-label" for="turnoTarde">Tarde</label>
        </div>
        <div>
            <span asp-validation-for="Turno" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3 form-check">
        <input asp-for="AceptaTerminos" class="form-check-input" type="checkbox" id="aceptaTerminos" />
        <label class="form-check-label" for="aceptaTerminos">Acepto los términos y condiciones</label>
        <div>
            <span asp-validation-for="AceptaTerminos" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Comentarios" class="form-label">Comentarios (opcional)</label>
        <textarea asp-for="Comentarios" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Comentarios" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Inscribir</button>
</form>

<partial name="_ValidationScriptsPartial" />
