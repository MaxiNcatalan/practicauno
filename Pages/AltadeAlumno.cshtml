@page
@model practicauno.Pages.AltadeAlumnoModel

@{
    ViewData["Title"] = "Alta de Alumno";
}

<h2>@ViewData["Title"]</h2>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

<form method="post" novalidate>
    <div class="form-group">
        <label asp-for="Alumno.Nombre" class="control-label"></label>
        <input asp-for="Alumno.Nombre" class="form-control" />
        <span asp-validation-for="Alumno.Nombre" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Alumno.Email" class="control-label"></label>
        <input asp-for="Alumno.Email" class="form-control" />
        <span asp-validation-for="Alumno.Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Alumno.Carrera" class="control-label"></label>
        <input asp-for="Alumno.Carrera" class="form-control" />
        <span asp-validation-for="Alumno.Carrera" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Alumno.Edad" class="control-label"></label>
        <input asp-for="Alumno.Edad " class="form-control" />
        <span asp-validation-for="Alumno.Edad" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
</form>
